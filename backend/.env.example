# ---------------------------------------------------------------------------
# AegisOps backend — environment template
# Copy to `backend/.env` and fill in LOCAL values. Never commit a real `.env`.
# Placeholders only. Do NOT put real secrets, endpoints, or identifiers here.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (local frontend only by default).
CORS_ORIGINS=http://localhost:3000

# --- Database (SQLAlchemy) ---
# Assembled from the individual parts below (no real URL committed).
POSTGRES_USER=CHANGEME_LOCAL_DB_USER
POSTGRES_PASSWORD=CHANGEME_LOCAL_DB_PASSWORD
POSTGRES_DB=aegisops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- AI provider selection ---
# "mock" (default, deterministic, no credentials) or "azure".
AI_PROVIDER=mock

# --- Azure AI provider (ONLY used when AI_PROVIDER=azure) ---
# Leave blank locally. Configure via a real environment or Key Vault later.
# Do NOT commit real endpoints, deployment names, or keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=

# --- Salesforce integration (disabled by default) ---
SALESFORCE_ENABLED=false
# ONLY used when SALESFORCE_ENABLED=true. Leave blank locally.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# --- Observability (OpenTelemetry-ready; optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
