# ---------------------------------------------------------------------------
# AegisOps — root environment template (Docker Compose)
# Copy to `.env` and fill in LOCAL values. Never commit a real `.env`.
# Placeholders only. Do NOT put real secrets, endpoints, or identifiers here.
# ---------------------------------------------------------------------------

# --- PostgreSQL (local container) ---
POSTGRES_USER=CHANGEME_LOCAL_DB_USER
POSTGRES_PASSWORD=CHANGEME_LOCAL_DB_PASSWORD
POSTGRES_DB=aegisops
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend service ---
FRONTEND_PORT=3000

# --- Feature toggles (safe defaults for local MVP) ---
# Deterministic mock provider; no credentials required.
AI_PROVIDER=mock
# Salesforce integration disabled by default (fake adapter used locally).
SALESFORCE_ENABLED=false
